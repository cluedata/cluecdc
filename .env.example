# Development-only values. Copy this file to .env for an immediately runnable,
# loopback-only stack. Run `python scripts/bootstrap.py` to replace these values
# with unique local secrets before keeping data or sharing the environment.

# Application
ENVIRONMENT=development
AUTH_MODE=developer
AUTH_TOKENS_JSON={}
LOG_LEVEL=info
CLUECDC_WEB_PORT=3000
CLUECDC_API_PORT=8000
METADATA_PORT=5433
CORS_ORIGINS=["http://localhost:3000"]

# ClueCDC metadata and secret storage (development examples, not real secrets)
METADATA_PASSWORD=cluecdc-metadata-local-only
SECRET_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
CONNECT_SECRET_TOKEN=local-connect-token-change-before-production-0001

# Kafka and Kafka Connect
KAFKA_EXTERNAL_HOST=localhost
KAFKA_PORT=9092
KAFKA_CONNECT_PORT=8083

# PostgreSQL demo source and destination
POSTGRES_SOURCE_PORT=5434
POSTGRES_DESTINATION_PORT=5435
SOURCE_ADMIN_PASSWORD=cluecdc-source-admin-local-only
SOURCE_PASSWORD=cluecdc-source-local-only
DESTINATION_ADMIN_PASSWORD=cluecdc-destination-admin-local-only
DESTINATION_PASSWORD=cluecdc-destination-local-only

# MySQL demo source and destination
MYSQL_SOURCE_PORT=3307
MYSQL_DESTINATION_PORT=3308
MYSQL_SOURCE_ADMIN_PASSWORD=cluecdc-mysql-source-admin-local-only
MYSQL_SOURCE_PASSWORD=cluecdc-mysql-source-local-only
MYSQL_DESTINATION_ADMIN_PASSWORD=cluecdc-mysql-destination-admin-local-only
MYSQL_DESTINATION_PASSWORD=cluecdc-mysql-destination-local-only

# Optional CloudBeaver database explorer
CLOUDBEAVER_PORT=8978
CLOUDBEAVER_VERSION=26.2.0
CB_SERVER_NAME=ClueCDC Database Explorer
CB_SERVER_URL=http://localhost:8978
CB_ADMIN_NAME=cluecdc
CB_ADMIN_PASSWORD=ClueCDC-local-only-9

# Optional Lakehouse profile (development examples only)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=cluecdc-minio
MINIO_SECRET_KEY=cluecdc-minio-local-only
