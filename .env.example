# Local and demo setup: python scripts/bootstrap.py
# Empty secrets are generated once. Never use local credentials in production.
CLUECDC_LOCAL_PASSWORD=
SECRET_ENCRYPTION_KEY=
CONNECT_SECRET_TOKEN=
SESSION_SECRET=

# Development-only sign-in. Production must disable this account bootstrap.
BOOTSTRAP_DEFAULT_ADMIN=true
DEFAULT_ADMIN_EMAIL=admin@cluecdc.local
DEFAULT_ADMIN_PASSWORD=cluecdc-admin

# Useful host overrides. All published ports bind to 127.0.0.1.
CLUECDC_WEB_PORT=3000
CLUECDC_API_PORT=8000
KAFKA_PORT=9092
KAFKA_CONNECT_PORT=8083
POSTGRES_DEMO_PORT=5434
MYSQL_DEMO_PORT=3307
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
# When changing the web port, update both origins as well.
PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# Existing installations: retain METADATA_PASSWORD and all POSTGRES_DEMO_*,
# MYSQL_DEMO_*, MINIO_SECRET_KEY and CLICKHOUSE_TEST_PASSWORD overrides in .env.
# They take precedence over the shared password. Initialization never rotates
# database passwords. See docs/operations/configuration.md before upgrading.
# Advanced settings and production secrets are documented there; application
# defaults remain in docker-compose.yml and apps/api/app/core/config.py.
