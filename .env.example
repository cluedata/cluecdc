# Ready-to-run loopback-only demo. Passwords and keys below are public examples.
# Copy this file to .env; no host Python or Node.js is required for Compose.
# For optional unique secrets before first startup, see docs/operations/configuration.md.
# ClueCDC
ENVIRONMENT=development
AUTH_MODE=session
# Public development/demo login. Production rejects this when enabled.
BOOTSTRAP_DEFAULT_ADMIN=true
DEFAULT_ADMIN_EMAIL=admin@cluecdc.local
DEFAULT_ADMIN_PASSWORD=cluecdc-admin
# Public development example; never use in a shared or production deployment.
SESSION_SECRET=development-session-secret-change-me-0001
SESSION_TTL_SECONDS=28800
INVITE_TTL_SECONDS=86400
PUBLIC_URL=http://localhost:3000
# Legacy bearer-token mode remains available for upgrades and API automation.
AUTH_TOKENS_JSON={}
LOG_LEVEL=info
CLUECDC_WEB_PORT=3000
CLUECDC_API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# Metadata Database
# Public development examples. Preserve existing values when reusing database volumes.
METADATA_PASSWORD=cluecdc-metadata-local-only
SECRET_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
CONNECT_SECRET_TOKEN=local-connect-token-change-before-production-0001

# Optional worker tuning
WORKER_CONCURRENCY=4
RECONCILE_INTERVAL_SECONDS=10
INFRASTRUCTURE_HEALTH_INTERVAL_SECONDS=30
JOB_LEASE_SECONDS=300
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=2
JOB_RETRY_MAX_SECONDS=60
JOB_RETRY_JITTER_RATIO=0.2
CONNECTOR_OPERATION_LEASE_SECONDS=300
AUTO_RECOVERY_ENABLED=true
AUTO_RECOVERY_MAX_ATTEMPTS=5
AUTO_RECOVERY_BASE_DELAY_SECONDS=10
AUTO_RECOVERY_MAX_DELAY_SECONDS=300
AUTO_RECOVERY_JITTER_RATIO=0.2
INTEGRATION_TIMEOUT_SECONDS=10
# Production-only escape hatch for a reviewed private plaintext broker network.
ALLOW_INSECURE_KAFKA=false

# Kafka
KAFKA_EXTERNAL_HOST=localhost
KAFKA_PORT=9092

# Kafka Connect
KAFKA_CONNECT_PORT=8083

# Frontend
# API_INTERNAL_URL is set to http://cluecdc-api:8000 by Compose.
# Offer Azure managed identity only when the API/worker runs on an Azure host
# with a configured identity and network access to Synapse and Storage.
AZURE_MANAGED_IDENTITY_ENABLED=false
