# Integration/E2E fixtures used by compose.test.yaml only.
# Public local-only defaults. Change these before using a shared environment.
# Source: cluecdc_source / source_user / source123
# Destination: cluecdc_destination / destination_user / destination123
AUTH_MODE=developer
POSTGRES_SOURCE_PORT=5434
POSTGRES_DESTINATION_PORT=5435
SOURCE_ADMIN_PASSWORD=postgres123
SOURCE_PASSWORD=source123
DESTINATION_ADMIN_PASSWORD=postgres123
DESTINATION_PASSWORD=destination123

MYSQL_SOURCE_PORT=3307
MYSQL_DESTINATION_PORT=3308
MYSQL_SOURCE_ADMIN_PASSWORD=mysql123
MYSQL_SOURCE_PASSWORD=source123
MYSQL_DESTINATION_ADMIN_PASSWORD=mysql123
MYSQL_DESTINATION_PASSWORD=destination123

# MinIO is built from pinned upstream source because official registry images are unavailable.
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
