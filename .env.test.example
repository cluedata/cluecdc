# Integration/E2E fixtures used by compose.test.yaml only.
AUTH_MODE=developer
POSTGRES_SOURCE_PORT=5434
POSTGRES_DESTINATION_PORT=5435
SOURCE_ADMIN_PASSWORD=cluecdc-source-admin-test-only
SOURCE_PASSWORD=cluecdc-source-test-only
DESTINATION_ADMIN_PASSWORD=cluecdc-destination-admin-test-only
DESTINATION_PASSWORD=cluecdc-destination-test-only

MYSQL_SOURCE_PORT=3307
MYSQL_DESTINATION_PORT=3308
MYSQL_SOURCE_ADMIN_PASSWORD=cluecdc-mysql-source-admin-test-only
MYSQL_SOURCE_PASSWORD=cluecdc-mysql-source-test-only
MYSQL_DESTINATION_ADMIN_PASSWORD=cluecdc-mysql-destination-admin-test-only
MYSQL_DESTINATION_PASSWORD=cluecdc-mysql-destination-test-only

# MinIO is built from pinned upstream source because official registry images are unavailable.
MINIO_PORT=9000
MINIO_ACCESS_KEY=cluecdc-test-access
MINIO_SECRET_KEY=cluecdc-test-secret-key
