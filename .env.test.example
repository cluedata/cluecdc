# Integration/E2E fixtures used by compose.test.yaml only.
# Public local-only defaults. Change these before using a shared environment.
# PostgreSQL demo service: postgres-demo:5432 (host port 5434)
# MySQL demo service: mysql-demo:3306 (host port 3307)
# Each service contains both logical fixture databases:
# - cluecdc_source / source_user / source123
# - cluecdc_destination / destination_user / destination123
AUTH_MODE=developer
POSTGRES_DEMO_PORT=5434
POSTGRES_DEMO_ADMIN_PASSWORD=postgres123
POSTGRES_DEMO_SOURCE_PASSWORD=source123
POSTGRES_DEMO_DESTINATION_PASSWORD=destination123

MYSQL_DEMO_PORT=3307
MYSQL_DEMO_ADMIN_PASSWORD=mysql123
MYSQL_DEMO_SOURCE_PASSWORD=source123
MYSQL_DEMO_DESTINATION_PASSWORD=destination123

# MinIO is built from pinned upstream source because official registry images are unavailable.
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Optional ClickHouse profile: docker compose --profile clickhouse ...
CLICKHOUSE_TEST_PORT=8123
CLICKHOUSE_TEST_PASSWORD=clickhouse123
